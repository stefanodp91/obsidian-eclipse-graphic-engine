{
  "name": "@obsidian-eclipse/sample-endless-platformer-capacitor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "./android.sh",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @obsidian-eclipse/sample-endless-platformer -- --base ./ --outDir ../endless-platformer-capacitor/www --emptyOutDir",
    "sync": "npm run build:web && cap sync",
    "open:android": "npm run sync && cap open android",
    "open:ios": "npm run sync && cap open ios",
    "build:apk": "npm run sync && cap build android --androidreleasetype APK",
    "build:ipa": "npm run sync && cap build ios",
    "ios": "./ios.sh"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8",
    "@capacitor/android": "^8",
    "@capacitor/core": "^8",
    "@capacitor/device": "^8",
    "@capacitor/ios": "^8",
    "@capacitor/preferences": "^8",
    "obsidian-eclipse-capacitor-plugins": "^0.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8"
  }
}
